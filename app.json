{
  "expo": {
    "name": "Music",
    "slug": "musiqapp",
    "scheme": "musiqapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "site.egokam.musiqapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Music to choose an image for your playlist cover.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withMusiqNativeWidget",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MusiqNowPlaying",
              "displayName": "Musiqapp",
              "description": "See and play the track currently on Musiqapp.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "d9783c13-3b14-4014-8b3a-57aec87000e9"
      }
    },
    "owner": "kotmani"
  }
}
