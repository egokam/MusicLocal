{
  "expo": {
    "name": "Music",
    "slug": "musiqapp",
    "scheme": "musiqapp",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "site.egokam.musiqapp",
      "buildNumber": "14",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "site.egokam.musiqapp",
      "versionCode": 14,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Music to choose an image for your playlist cover.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withMusiqNativeWidget",
      "./plugins/withMusiqYoutubeKit",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MusiqNowPlaying",
              "displayName": "Musiqapp",
              "description": "See and play the track currently on Musiqapp.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "expo-background-task",
      "expo-image",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback"
          ],
          "enableFFmpeg": true
        }
      ],
      [
        "expo-awesome-app-icon",
        {
          "icons": {
            "ocean": {
              "ios": { "light": "./assets/icons/ocean.png" },
              "android": {
                "image": "./assets/icons/ocean.png",
                "foregroundImage": "./assets/icons/ocean.png",
                "backgroundColor": "#159FDB"
              }
            },
            "violet": {
              "ios": { "light": "./assets/icons/violet.png" },
              "android": {
                "image": "./assets/icons/violet.png",
                "foregroundImage": "./assets/icons/violet.png",
                "backgroundColor": "#9016D2"
              }
            },
            "amber": {
              "ios": { "light": "./assets/icons/amber.png" },
              "android": {
                "image": "./assets/icons/amber.png",
                "foregroundImage": "./assets/icons/amber.png",
                "backgroundColor": "#E9A115"
              }
            },
            "forest": {
              "ios": { "light": "./assets/icons/forest.png" },
              "android": {
                "image": "./assets/icons/forest.png",
                "foregroundImage": "./assets/icons/forest.png",
                "backgroundColor": "#167D3C"
              }
            },
            "midnight": {
              "ios": { "light": "./assets/icons/midnight.png" },
              "android": {
                "image": "./assets/icons/midnight.png",
                "foregroundImage": "./assets/icons/midnight.png",
                "backgroundColor": "#1D4CC4"
              }
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9783c13-3b14-4014-8b3a-57aec87000e9"
      }
    },
    "owner": "kotmani"
  }
}
